PORT=4000
JWT_SECRET=change-me-now
# Production requires a random secret of at least 32 characters (never this placeholder).
# Keep the existing encryption key when upgrading; changing it requires token migration.
SMARTTHINGS_TOKEN_SECRET=
# Comma-separated exact browser origins, without a trailing slash.
APP_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:4000
# Set only after validating the number of trusted reverse-proxy hops in deployment.
TRUST_PROXY_HOPS=0
SMARTTHINGS_TOKEN=your-smartthings-personal-access-token
LG_CLIENT_ID=your-lg-client-id
LG_CLIENT_SECRET=your-lg-client-secret
LG_REFRESH_TOKEN=your-lg-refresh-token
DATABASE_URL=postgres://postgres:1410@localhost:5432/wattstatus
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=wattstatus
TARIFFS_API_URL=
