# WattStatus backend. Copy to .env for local development. Never commit real values.
# Homologation and production values live only in the Netlify environment
# (see docs/PLANO_HOMOLOGACAO_PRODUCAO.md).

PORT=4000
# "production" turns on Secure/__Host- cookies and refuses weak secrets.
NODE_ENV=development
JWT_SECRET=replace-with-long-random-value
SMARTTHINGS_TOKEN_SECRET=replace-with-distinct-long-random-value
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=wattstatus
# Allowed browser origins (comma separated). On Netlify, falls back to URL.
APP_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:4000
TRUST_PROXY_HOPS=0
TARIFFS_API_URL=

# Scheduled energy collection (backend/netlify/functions/collect-energy.ts).
# Every value is clamped by COLLECTION_LIMITS in the collector.
ENERGY_COLLECTION_ENABLED=false
ENERGY_COLLECTION_INTERVAL_MINUTES=30
ENERGY_COLLECTION_BATCH_SIZE=60
ENERGY_COLLECTION_CONCURRENCY=4
ENERGY_COLLECTION_PER_USER=2

# SmartThings OAuth-In SmartApp ("Entrar com conta Samsung").
# Leave empty to offer only personal access tokens.
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
# Must match the redirect URI registered on the SmartApp exactly.
SMARTTHINGS_REDIRECT_URI=https://wattstatus.netlify.app/integracoes/smartthings/callback
# Optional overrides of the SmartThings OAuth endpoints.
SMARTTHINGS_AUTHORIZE_URL=
SMARTTHINGS_TOKEN_URL=

# WattStatus AI (docs/WATTSTATUS_AI.md § 7). Off by default: the assistant
# answers from the deterministic engine and never calls a model.
AI_ENABLED=false
AI_PROVIDER=anthropic
# Server-side only. Use a key from a homologation workspace for homologation.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_REASONING=claude-sonnet-5-5
AI_MAX_OUTPUT_TOKENS=500
AI_REQUEST_TIMEOUT_MS=12000
AI_MAX_TOOL_CALLS=2
AI_DAILY_USER_BUDGET=60
AI_MONTHLY_GLOBAL_BUDGET=20000
# Hard cap on estimated model spend per calendar month (USD); 0 = off.
AI_MONTHLY_COST_LIMIT_USD=0
AI_MAX_CONCURRENT_REQUESTS=4
AI_PRICE_INPUT_PER_MTOK=0.1
AI_PRICE_OUTPUT_PER_MTOK=0.5
AI_USAGE_RETENTION_DAYS=90
# Proactive alert delivery. Keep "off": no delivery channel is validated.
AI_ALERTS_DELIVERY=off

# Administrative access does NOT come from an environment variable.
# Grants are records in admin_grants, written by backend/scripts/admin-grant.cjs
# with direct database access. AI_ADMIN_EMAILS is no longer read.
